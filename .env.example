# Copy to .env and fill in. Never commit .env.
# Multi-provider model panel (LiteLLM reads these provider keys)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Open-model provider (e.g. Together / Groq / Fireworks) — set the one you use
TOGETHER_API_KEY=

# Model panel (LiteLLM model strings)
SENTINEL_AGENT_MODEL=anthropic/claude-haiku-4-5-20251001
SENTINEL_ATTACKER_MODEL=openai/gpt-4o-mini
SENTINEL_JUDGE_MODEL=anthropic/claude-haiku-4-5-20251001

# Infra (used from docker-compose onward)
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel
REDIS_URL=redis://localhost:6379/0

# Langfuse (observability)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
