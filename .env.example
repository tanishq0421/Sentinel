# Copy to .env and fill in. Never commit .env.
# Multi-provider model panel (LiteLLM reads these provider keys)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Open-model provider (e.g. Together / Groq / Fireworks) — set the one you use
TOGETHER_API_KEY=

# Model panel (LiteLLM model strings)
SENTINEL_AGENT_MODEL=anthropic/claude-haiku-4-5-20251001
SENTINEL_ATTACKER_MODEL=openai/gpt-4o-mini
SENTINEL_JUDGE_MODEL=anthropic/claude-haiku-4-5-20251001

# Infra (local dev host ports; container-internal ports stay 5432/6379)
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5433/sentinel
# Dedicated DB for integration tests (they DELETE rows for isolation)
DATABASE_URL_TEST=postgresql://sentinel:sentinel@localhost:5433/sentinel_test
REDIS_URL=redis://localhost:6380/0

# Langfuse (observability)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
